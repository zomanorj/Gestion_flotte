# Configuration de l'API : validée au démarrage (app/config.py), qui refuse de démarrer et liste
# les problèmes si une valeur est invalide. Les paramètres métier (prix du gasoil, barème de paie,
# seuils d'alerte) ne sont pas ici : ils se règlent dans l'application, page Paramètres.

# developpement | test | production (production refuse un secret faible, SEED_DEMO et un disque éphémère)
ENVIRONNEMENT=developpement

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flotte_db
# En production (Railway) : MYSQL_URL=mysql://user:pass@host:port/db remplace les variables DB_*

# Secret de signature des tokens : longue chaîne aléatoire, différente par environnement
# (32 caractères minimum en production) : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=a_remplacer_par_une_longue_chaine_aleatoire
DUREE_TOKEN_HEURES=24
PORT=5000
# Origine(s) du client web, séparées par des virgules
CLIENT_URL=http://localhost:5173

# Fuseau des dates métier (CURDATE / NOW côté MySQL suivent ce fuseau)
APP_TIMEZONE=Indian/Antananarivo

# Le schéma de la base est créé et mis à jour au démarrage (migrations Alembic, dossier migrations/).
# Données de démonstration (comptes en password123) : 1 pour les charger sur une base sans compte.
# Jamais en production.
SEED_DEMO=0

# Premier administrateur : créé au démarrage seulement si aucun admin actif n'existe
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stockage des fichiers uploadés : local (UPLOADS_DIR, à monter sur un volume persistant) ou s3
STOCKAGE=local
UPLOADS_DIR=
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<compte>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Derrière un proxy (Railway, nginx) : IP des proxys de confiance pour X-Forwarded-For
# FORWARDED_ALLOW_IPS=*
